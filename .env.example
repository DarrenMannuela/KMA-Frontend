# Copy to .env if you want to change these; .env is git-ignored.

# Which of the computer's network addresses serve the app, and on which
# port. The recommended setting is 127.0.0.1 with port 8088: this computer
# only, plus `tailscale serve --bg 8088`, which connects from this computer
# too and gives everyone the HTTPS address. (Docker Desktop can't bind
# port 80 to 127.0.0.1 without its privileged helper, so use a port above
# 1023 there.) Empty: port 80 on every network, so anyone on the same
# Wi-Fi reaches it over plain http.
KMA_WEB_BIND=
KMA_WEB_PORT=
