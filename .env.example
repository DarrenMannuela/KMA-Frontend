# Copy to .env if you want to change these; .env is git-ignored.

# Which of the Mac's network addresses serve the app on port 80.
# 127.0.0.1: this Mac only, plus `tailscale serve`, which connects from
# this Mac too (the recommended setting). Empty or 0.0.0.0: also anyone
# on the same Wi-Fi or LAN.
KMA_WEB_BIND=
