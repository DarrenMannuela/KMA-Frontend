node_modules
dist
*.local

# ── Secrets ──────────────────────────────────────────────────────────
# Nothing secret belongs in the frontend at all (everything in it is
# sent to every browser), but keep these out in case one is ever made.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
.netrc
.npmrc

# Logs (npm-debug.log and the like)
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Local AI-agent tooling (skills, hooks, agent configs) — personal/
# machine-specific, not something every clone of this repo should inherit.
.claude/
.agents/
.codex/
.impeccable/
skills-lock.json

# Playwright E2E — generated run output, plus a real logged-in session
# cookie written by tests/e2e/global-setup.ts. Never commit either.
/test-results/
/playwright-report/
/tests/e2e/.auth/

# OS
.DS_Store
